#!/usr/bin/env python3
"""Launcher: works from anywhere, including through a symlink."""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

try:
    from golf.app import main  # noqa: E402
    main()
except KeyboardInterrupt:   # Ctrl-C while it starts up
    sys.exit(130)
